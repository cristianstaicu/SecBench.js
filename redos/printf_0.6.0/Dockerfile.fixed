# Auto-generated by generate_dockerfile.py for the SecBench.js benchmark.
# Entry : printf@0.6.1  (redos)
# CVE   : CVE-2021-23354
# Repo  : adaltas/node-printf
# Source: git clone https://github.com/adaltas/node-printf @ 0.6.1 (fixed)
#
# Build context is THIS folder. Build & run with, e.g.:
#   docker build -t secbench-fixed/printf_0.6.0 redos/printf_0.6.0
#   docker run --rm secbench-fixed/printf_0.6.0
FROM node:16-bullseye

# System tools required by the exploits (curl, fuser via psmisc, build tools, ...).
# yarn is intentionally omitted: the node image already ships it, and Debian's
# apt 'yarn' is a different, conflicting package.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl zip psmisc g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /exploit/printf_0.6.0

# Recreate the flag file the path-traversal exploits read as ../flag.html
RUN printf '<!DOCTYPE html>\n<html>\n<body>\n\n<h1>CISPA</h1>\n<p>vulns4js! is here.</p>\n\n</body>\n</html>' > /exploit/flag.html

# Benchmark metadata (package.json) + jest test case
COPY . .

RUN git clone https://github.com/adaltas/node-printf.git node_modules/printf \
    && cd node_modules/printf \
    && if ! (git checkout -q "v0.6.1" || git checkout -q "0.6.1"); then \
           echo "ERROR: cannot check out version tag v0.6.1/0.6.1 in https://github.com/adaltas/node-printf." >&2; \
           echo "       Building anyway would silently use the default branch, which is" >&2; \
           echo "       neither printf@0.6.1 nor the pinned commit, so the exploit" >&2; \
           echo "       oracle would be measuring the wrong code." >&2; \
           echo "       Fix the version/commit for printf in repositories.csv, or" >&2; \
           echo "       regenerate with --allow-npm-fallback to install from npm." >&2; \
           exit 1; \
       fi \
    && npm install --no-audit --no-fund --ignore-scripts \
    && (npm run build --if-present || echo "WARNING: build step failed/partial; continuing") \
    && (npm run prepare --if-present || echo "WARNING: prepare step failed/partial; continuing")

# jest installed globally so it does not disturb the package tree
RUN npm install -g --no-audit --no-fund jest

CMD ["jest", "--runInBand"]
