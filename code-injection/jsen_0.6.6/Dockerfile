    && cd node_modules/jsen \
    && if ! (git checkout -q "v0.6.6" || git checkout -q "0.6.6"); then \
           echo "ERROR: cannot check out version tag v0.6.6/0.6.6 in https://github.com/bugventure/jsen." >&2; \
