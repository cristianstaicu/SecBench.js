# Auto-generated by generate_dockerfile.py for the SecBench.js benchmark.
# Entry : serialize-javascript@3.1.0  (code-injection)
# CVE   : CVE-2020-7660
# Repo  : yahoo/serialize-javascript
# Source: git clone https://github.com/yahoo/serialize-javascript @ 3.1.0 (fixed)
#
# Build context is THIS folder. Build & run with, e.g.:
#   docker build -t secbench-fixed/serialize-javascript_2.0.0 code-injection/serialize-javascript_2.0.0
#   docker run --rm secbench-fixed/serialize-javascript_2.0.0
FROM node:16-bullseye

# System tools required by the exploits (curl, fuser via psmisc, build tools, ...).
# yarn is intentionally omitted: the node image already ships it, and Debian's
# apt 'yarn' is a different, conflicting package.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl zip psmisc g++ make python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /exploit/serialize-javascript_2.0.0

# Recreate the flag file the path-traversal exploits read as ../flag.html
RUN printf '<!DOCTYPE html>\n<html>\n<body>\n\n<h1>CISPA</h1>\n<p>vulns4js! is here.</p>\n\n</body>\n</html>' > /exploit/flag.html

# Benchmark metadata (package.json) + jest test case
COPY . .

RUN git clone https://github.com/yahoo/serialize-javascript.git node_modules/serialize-javascript \
    && cd node_modules/serialize-javascript \
    && if ! (git checkout -q "f21a6fb3ace2353413761e79717b2d210ba6ccbd" || { git fetch -q --depth 1 origin "f21a6fb3ace2353413761e79717b2d210ba6ccbd" && git checkout -q FETCH_HEAD; } || git checkout -q "v3.1.0" || git checkout -q "3.1.0"); then \
           echo "ERROR: cannot check out commit f21a6fb3ac / tag v3.1.0 in https://github.com/yahoo/serialize-javascript." >&2; \
           echo "       Building anyway would silently use the default branch, which is" >&2; \
           echo "       neither serialize-javascript@3.1.0 nor the pinned commit, so the exploit" >&2; \
           echo "       oracle would be measuring the wrong code." >&2; \
           echo "       Fix the version/commit for serialize-javascript in repositories.csv, or" >&2; \
           echo "       regenerate with --allow-npm-fallback to install from npm." >&2; \
           exit 1; \
       fi \
    && npm install --no-audit --no-fund --ignore-scripts \
    && (npm run build --if-present || echo "WARNING: build step failed/partial; continuing") \
    && (npm run prepare --if-present || echo "WARNING: prepare step failed/partial; continuing")

# jest installed globally so it does not disturb the package tree
RUN npm install -g --no-audit --no-fund jest

CMD ["jest", "--runInBand"]
