# Recreate the flag file the path-traversal exploits read as ../flag.html
RUN printf '<!DOCTYPE html>\n<html>\n<body>\n\n<h1>CISPA</h1>\n<p>vulns4js! is here.</p>\n\n</body>\n</html>' > /exploit/flag.html

# Benchmark metadata (package.json) + jest test case
COPY . .

RUN git clone https://github.com/caspervonb/wrlc.git node_modules/wrlc \
    && cd node_modules/wrlc \
    && if ! (git checkout -q "v0.2.5" || git checkout -q "0.2.5"); then \
           echo "ERROR: cannot check out version tag v0.2.5/0.2.5 in https://github.com/caspervonb/wrlc." >&2; \
