RUN git clone https://github.com/react-atomic/react-atomic-organism.git node_modules/set-object-value \
    && cd node_modules/set-object-value \
    && if ! (git checkout -q "c8ec63388f7785078cb27275b56ed955ffd3db6c" || { git fetch -q --depth 1 origin "c8ec63388f7785078cb27275b56ed955ffd3db6c" && git checkout -q FETCH_HEAD; } || git checkout -q "v0.0.6" || git checkout -q "0.0.6"); then \
